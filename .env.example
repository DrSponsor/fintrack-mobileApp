# API base URL. On an Android emulator, http://10.0.2.2:3000 reaches the host
# machine's localhost. On a physical device over USB, use `adb reverse
# tcp:3000 tcp:3000` and point this at http://localhost:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Alternative to EXPO_PUBLIC_API_URL — checked first is EXPO_PUBLIC_API_URL,
# this is the fallback. See app.config.ts's getApiUrl().
DEV_API_URL=

APP_ENV=development
EAS_PROJECT_ID=
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
