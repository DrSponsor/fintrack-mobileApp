<?xml version="1.0" encoding="utf-8"?>
<!--
  What a release build does NOT ship.

  Gradle merges this file over src/main for release variants only, so the debug
  build — and therefore the dev client — keeps everything below. Each entry is
  removed because a release build cannot reach it, and because leaving it in
  makes the app look, to any scanner, like the exact thing it is not.

  This is not cosmetic. Google Play Protect HARD BLOCKED the demo APK on a real
  device with "This app can request access to sensitive data. This can increase
  the risk of identity theft or financial fraud." Both declarations below are
  first-order triggers for that verdict on a finance app, and neither is used
  by anything a release build can open.

  tools:node="remove" is how a higher-priority manifest deletes something a
  LIBRARY manifest contributed. The service is not declared in src/main — it
  comes from modules/notification-capture — so it cannot simply be deleted from
  a file; it has to be removed during the merge.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

  <!--
    Draw over other apps.

    React Native contributes this for the dev menu and the redbox overlay.
    Nothing in a release build uses it.

    It is also the permission behind Android overlay attacks — a transparent
    window drawn on top of a real banking app to harvest what is typed into it,
    which is the single most common way Android banking credentials are stolen.
    A finance app requesting it is precisely the shape Play Protect is built to
    catch, and we were requesting it for a debug menu.
  -->
  <uses-permission
      android:name="android.permission.SYSTEM_ALERT_WINDOW"
      tools:node="remove" />

  <application>
    <!--
      The notification listener, from modules/notification-capture.

      Its only consumer is CaptureDebugScreen, which is reachable exclusively
      under __DEV__ — so a release build declares the right to read every
      notification on the device, including one-time passcodes and other
      apps' bank alerts, to power a screen nobody can open.

      The Expo module itself still links, so `isCaptureSupported` stays true in
      release. That is harmless while nothing reachable calls it: hasAccess()
      returns false and the app simply never appears in the system's listener
      settings. If notification capture ever becomes a real product feature —
      which it may well, since the banks have gone quiet on email — this block
      is what comes out, and the permission then needs a user-visible purpose
      and a justification at Play review.
    -->
    <service
        android:name="expo.modules.notificationcapture.NotificationCaptureService"
        tools:node="remove" />
  </application>
</manifest>
