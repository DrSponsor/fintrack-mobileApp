{
  "name": "fintrack-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:dev": "npx eas build --profile development --platform android",
    "build:staging": "npx eas build --profile staging --platform android",
    "build:prod": "npx eas build --profile production --platform all",
    "download-fonts": "node scripts/download-fonts.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@gorhom/bottom-sheet": "~5.0.0",
    "@hookform/resolvers": "~3.9.0",
    "@nozbe/watermelondb": "~0.27.0",
    "@react-native-community/netinfo": "~11.4.0",
    "@sentry/react-native": "~6.10.0",
    "@shopify/flash-list": "1.7.3",
    "@shopify/react-native-skia": "1.5.0",
    "@tanstack/react-query": "~5.60.0",
    "axios": "~1.7.0",
    "date-fns": "~4.1.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-background-fetch": "~13.0.0",
    "expo-battery": "~9.0.0",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-task-manager": "~12.0.0",
    "expo-updates": "~0.27.0",
    "jail-monkey": "2.8.5",
    "phosphor-react-native": "~2.1.0",
    "posthog-react-native": "~3.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "~7.53.0",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-keychain": "~9.2.0",
    "react-native-mmkv": "2.12.2",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-ssl-public-key-pinning": "^1.2.6",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "victory-native": "~41.6.0",
    "zod": "~3.23.0",
    "zustand": "~5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "~12.8.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.0",
    "concurrently": "^10.0.3",
    "eslint": "~9.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-dev-client": "~5.0.0",
    "jest": "~29.7.0",
    "jest-expo": "^52.0.6",
    "prettier": "~3.4.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.67.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
